# Copy this file to `.env` and fill in real values, or set these variables
# directly in your host's environment (e.g. the PythonAnywhere web-app config).
# Variables without a default in settings.py are REQUIRED — the app will
# refuse to start if they are missing.

# Django core
DJANGO_SECRET_KEY=            # required: generate a fresh 50-char random key
DJANGO_DEBUG=False           # optional: set to True only for local development

# Database
# On Vercel: set DATABASE_URL (added automatically once Vercel Postgres/Neon
# is connected to the project) and skip DB_ENGINE/DB_* below entirely - it
# takes priority over them.
DATABASE_URL=                # Vercel/Neon only: postgres://user:pass@host/db

# Elsewhere, DB_ENGINE selects the backend: 'sqlite' (local dev, no server
# needed) or 'mysql' (PythonAnywhere, the default). With sqlite, none of the
# DB_* settings below are required — only DB_NAME is used, defaulting to a
# local db.sqlite3.
DB_ENGINE=mysql              # 'sqlite' for local development, 'mysql' for PythonAnywhere
DB_NAME=qnondrum$default     # optional (mysql: has default; sqlite: path to db file)
DB_USER=qnondrum             # optional, mysql only (has default)
DB_PASSWORD=                 # required for mysql; unused for sqlite
DB_HOST=qnondrum.mysql.pythonanywhere-services.com  # optional, mysql only (has default)
DB_PORT=3306                 # optional, mysql only (has default)

# File storage (profile pictures, contest/QOTD images)
# On Vercel: set this (added automatically once Vercel Blob is connected to
# the project) so uploads go to Vercel Blob instead of local disk, which
# doesn't persist between deploys/invocations there. Leave blank elsewhere.
BLOB_READ_WRITE_TOKEN=

# Vercel only: your custom domain, if any, beyond the *.vercel.app one
# every deployment already gets (that one's allowed by default).
EXTRA_ALLOWED_HOST=

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com                 # optional (has default)
EMAIL_HOST_USER=putfundaofficial@gmail.com  # optional (has default)
EMAIL_HOST_PASSWORD=                      # required: Gmail app password
EMAIL_PORT=587                            # optional (has default)

# Google reCAPTCHA
RECAPTCHA_PRIVATE_KEY=       # required
RECAPTCHA_PUBLIC_KEY=        # required

# Google Sign-In (optional). Leave blank to hide the Google sign-in button
# entirely. Set up a Client ID in Google Cloud Console:
#   1. https://console.cloud.google.com/ -> create/select a project
#   2. APIs & Services -> OAuth consent screen -> configure it (External,
#      fill in app name/support email, add your own email as a test user)
#   3. APIs & Services -> Credentials -> Create Credentials ->
#      OAuth client ID -> Application type: Web application
#   4. Under "Authorized JavaScript origins" add:
#        http://127.0.0.1:8000
#        http://localhost:8000
#      (and your production domain, e.g. https://www.putfunda.com)
#      No redirect URI is needed - this uses Google's ID-token sign-in
#      button, not a redirect flow, so no client secret is needed either.
#   5. Copy the generated Client ID below.
GOOGLE_OAUTH_CLIENT_ID=

# PDF-to-contest import (optional). Leave blank to disable; uploading a
# PDF of questions when scheduling a contest will then show an error
# instead of working. Get a free key at https://aistudio.google.com/apikey
# (no payment required for the free tier).
GEMINI_API_KEY=
