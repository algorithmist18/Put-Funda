# Copy this file to `.env` and fill in real values, or set these variables
# directly in your host's environment (e.g. the PythonAnywhere web-app config).
# Variables without a default in settings.py are REQUIRED — the app will
# refuse to start if they are missing.

# Django core
DJANGO_SECRET_KEY=            # required: generate a fresh 50-char random key
DJANGO_DEBUG=False           # optional: set to True only for local development

# Database
# DB_ENGINE selects the backend: 'sqlite' (local dev, no server needed) or
# 'mysql' (production, the default). With sqlite, none of the DB_* settings
# below are required — only DB_NAME is used, defaulting to a local db.sqlite3.
DB_ENGINE=mysql              # 'sqlite' for local development, 'mysql' for production
DB_NAME=qnondrum$default     # optional (mysql: has default; sqlite: path to db file)
DB_USER=qnondrum             # optional, mysql only (has default)
DB_PASSWORD=                 # required for mysql; unused for sqlite
DB_HOST=qnondrum.mysql.pythonanywhere-services.com  # optional, mysql only (has default)
DB_PORT=3306                 # optional, mysql only (has default)

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com                 # optional (has default)
EMAIL_HOST_USER=putfundaofficial@gmail.com  # optional (has default)
EMAIL_HOST_PASSWORD=                      # required: Gmail app password
EMAIL_PORT=587                            # optional (has default)

# Google reCAPTCHA
RECAPTCHA_PRIVATE_KEY=       # required
RECAPTCHA_PUBLIC_KEY=        # required
